# Copy to services/api/.env (local only). NEVER commit real values. All variables are prefixed VAND_.
VAND_ENV=local
# API connects as a NON-owner role so Row-Level Security applies. See infra/database/roles.sql.
VAND_DATABASE_URL=postgresql+asyncpg://vand_app:CHANGE_ME@localhost:5432/vand_dev
VAND_WORKER_DATABASE_URL=postgresql+asyncpg://vand_worker:CHANGE_ME@localhost:5432/vand_dev
VAND_MIGRATION_DATABASE_URL=postgresql+psycopg://vand_owner:CHANGE_ME@localhost:5432/vand_dev
# Set true behind a transaction-mode pooler (e.g. Neon pooled endpoint).
VAND_DB_DISABLE_STATEMENT_CACHE=false
VAND_REDIS_URL=redis://localhost:6379/0

# Auth: "dev" is refused in staging/production. Production: oidc + the three values below.
VAND_AUTH_MODE=dev
VAND_OIDC_ISSUER=
VAND_OIDC_AUDIENCE=
VAND_OIDC_JWKS_URL=
VAND_REQUIRE_MFA_FOR_PRIVILEGED=true

# Storage: local for dev, s3 for Cloudflare R2 (private bucket).
VAND_STORAGE_BACKEND=local
VAND_STORAGE_LOCAL_DIR=./.data/objects
VAND_S3_ENDPOINT_URL=
VAND_S3_BUCKET=
VAND_S3_ACCESS_KEY_ID=
VAND_S3_SECRET_ACCESS_KEY=

# AI providers are optional. With none configured the product degrades to deterministic output / retrieval-only.
VAND_ANTHROPIC_API_KEY=
VAND_ANTHROPIC_MODEL=
VAND_OPENAI_API_KEY=
VAND_OPENAI_MODEL=
VAND_AI_ORG_DAILY_TOKEN_BUDGET=200000
